# ==========================================
# V2Online MP Online Portal - Backend Configuration
# ==========================================

PORT=5000
NODE_ENV=production

# Database Configuration (MySQL / Aiven Cloud)
DB_HOST=mysql-xxxx-xxxx.aivencloud.com
DB_PORT=10078
DB_USER=avnadmin
DB_PASSWORD=your_db_password
DB_NAME=defaultdb
DB_SSL=true

# JWT Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Resend HTTPS API (Recommended for Render & Cloud deployments)
# Communicates over HTTPS Port 443 - completely avoids Render SMTP port blocking
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=onboarding@resend.dev
# Once custom domain is verified at resend.com/domains:
# RESEND_FROM="V2Online MP Portal" <support@yourverifieddomain.com>

# Server URL & Admin Email
BASE_URL=https://v2-backend-zflw.onrender.com
ADMIN_EMAIL=admin@mponlineportal.com
EMAIL_FROM="V2Online MP Portal" <onboarding@resend.dev>

# Cashfree Payment Gateway (Optional)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST
CASHFREE_WEBHOOK_SECRET=
